{
  "name": "@mr-aftab-ahmad-khan/uploadmesh",
  "version": "0.1.0",
  "description": "Upload helpers for MERN apps: MIME/size validation, multipart field checks, S3-style signed URL builder, and queue-friendly metadata types.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": { "build": "tsup", "test": "vitest run", "typecheck": "tsc --noEmit", "prepublishOnly": "npm run build" },
  "keywords": ["upload", "multer", "s3", "validation", "mern", "merndev", "nodejs", "typescript"],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "peerDependencies": { "multer": "^1.4.0 || ^2.0.0" },
  "peerDependenciesMeta": { "multer": { "optional": true } },
  "engines": { "node": ">=18" },
  "author": "Aftab Ahmad Khan (https://github.com/aftab-ahmad-khan-dev)",
  "repository": { "type": "git", "url": "git+https://github.com/NPM-Packages-Modules/uploadmesh.git" },
  "bugs": { "url": "https://github.com/NPM-Packages-Modules/uploadmesh/issues" },
  "homepage": "https://github.com/NPM-Packages-Modules/uploadmesh#readme",
  "publishConfig": { "access": "public" }
}
