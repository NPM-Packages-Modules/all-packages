{
  "name": "@mr-aftab-ahmad-khan/npm-monorepo",
  "private": true,
  "description": "Monorepo: mern/, react-native/, and flutter/ — each subfolder is one package repo.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "mern/*",
    "react-native/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NPM-Packages-Modules/mern-packages.git"
  },
  "bugs": {
    "url": "https://github.com/NPM-Packages-Modules/mern-packages/issues"
  },
  "homepage": "https://github.com/NPM-Packages-Modules/mern-packages#readme"
}
